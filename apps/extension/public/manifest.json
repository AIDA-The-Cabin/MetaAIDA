{
  "manifest_version": 3,
  "name": "The Cabin — Virtual Try-On",
  "version": "0.7.0",
  "description": "See clothes on your own body, on any fashion site.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "The Cabin",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "permissions": ["storage", "scripting"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://*.fashiondays.ro/*", "*://*.freepeople.com/*", "*://localhost/*", "*://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["*://*.fashiondays.ro/*", "*://*.freepeople.com/*", "*://localhost/*", "*://127.0.0.1/*", "https://metaaida.pages.dev/*"]
}
