---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Profile — The Cabin">
  <section class="section wrap" style="max-width:760px">
    <h1 class="section-title" style="text-align:left" data-i18n="profile.title">Your profile</h1>
    <p class="muted" id="hello">Loading…</p>

    <div class="panel" style="margin-top:20px">
      <div class="field">
        <label class="checkbox">
          <input type="checkbox" id="consent" />
          <span data-i18n-html="profile.consent">I agree that my photo is processed by AI (Meta AI) only to generate the virtual try-on, per the
            <a href="#" style="color:var(--cabin-gold-300)">Privacy Policy</a>. Required before uploading.</span>
        </label>
      </div>

      <div class="field">
        <label data-i18n="profile.photoLabel">Your photo — full body, facing front, plain background</label>
        <div class="dropzone" id="drop"><span id="drop-text" data-i18n="profile.drop">Drop a photo here or click to choose</span>
          <input type="file" id="file" accept="image/*" hidden /></div>
        <p class="tag-ok" id="photo-status" data-i18n-html="profile.photoSet" style="margin-top:10px;display:none">&#10003; Photo set</p>
      </div>

      <div style="display:flex;gap:14px;flex-wrap:wrap">
        <div class="field" style="flex:1;min-width:150px"><label data-i18n="profile.height">Height (cm) — optional</label><input type="number" id="height" min="80" max="250" /></div>
        <div class="field" style="flex:1;min-width:150px"><label data-i18n="profile.weight">Weight (kg) — optional</label><input type="number" id="weight" min="30" max="300" /></div>
      </div>
      <button class="btn-ghost" id="save-measures" data-i18n="profile.save">Save measurements</button>
    </div>

    <h2 class="section-title" style="text-align:left;font-size:26px;margin-top:46px" data-i18n="profile.cabin">Your Cabin</h2>
    <div class="looks" id="looks"><p class="muted">…</p></div>

    <div style="margin-top:42px">
      <button class="btn-ghost" id="delete" style="border-color:#5a2b2b;color:#cc8f8f" data-i18n="profile.delete">Delete my data</button>
    </div>
  </section>

  <script>
    const API = import.meta.env.PUBLIC_API_BASE ?? '';
    const CONSENT_VERSION = 'v1';
    const L = (window as any).__lang || 'en';
    const T = {
      en: { hello: (n: string, p: boolean) => `Hi, ${n}. ` + (p ? 'Your profile is ready.' : 'Upload a photo to get started.'),
        empty: 'Nothing in your Cabin yet. Try a product from the extension or a partner store.',
        uploading: 'Uploading…', drop: 'Drop a photo here or click to choose', fail: 'Upload failed — try again',
        consentAlert: 'Please accept processing before uploading.', confirmDel: 'Permanently delete your photo and all your try-ons?',
        saved: 'Saved ✓', save: 'Save measurements', down: 'Worker unavailable (start @aida/api).' },
      ro: { hello: (n: string, p: boolean) => `Salut, ${n}. ` + (p ? 'Profilul tău e gata.' : 'Încarcă o poză pentru a începe.'),
        empty: 'Încă nimic în Cabină. Probează un produs din extensie sau de pe un magazin partener.',
        uploading: 'Se încarcă…', drop: 'Trage o poză aici sau apasă pentru a alege', fail: 'Încărcare eșuată — încearcă din nou',
        consentAlert: 'Te rugăm să accepți procesarea înainte de încărcare.', confirmDel: 'Ștergem definitiv fotografia și toate probele tale?',
        saved: 'Salvat ✓', save: 'Salvează măsurile', down: 'Worker indisponibil (pornește @aida/api).' },
    }[L as 'en' | 'ro'];

    const $ = (s: string) => document.querySelector(s) as any;

    function resize(file: File, maxH = 1024): Promise<Blob> {
      return new Promise((resolve) => {
        const img = new Image();
        img.onload = () => {
          const scale = Math.min(1, maxH / img.height);
          const w = Math.round(img.width * scale), h = Math.round(img.height * scale);
          const c = document.createElement('canvas'); c.width = w; c.height = h;
          c.getContext('2d')!.drawImage(img, 0, 0, w, h);
          c.toBlob((b) => resolve(b as Blob), 'image/webp', 0.85);
        };
        img.src = URL.createObjectURL(file);
      });
    }

    async function loadProfile() {
      try {
        const p = await (await fetch(API + '/v1/profile')).json();
        $('#hello').textContent = T.hello(p.displayName, p.hasPhoto);
        $('#consent').checked = !!p.consentVersion;
        if (p.hasPhoto) $('#photo-status').style.display = 'block';
        if (p.heightCm) $('#height').value = p.heightCm;
        if (p.weightKg) $('#weight').value = p.weightKg;
      } catch { $('#hello').textContent = T.down; }
    }
    async function loadLooks() {
      try {
        const { items } = await (await fetch(API + '/v1/cabin')).json();
        if (!items.length) { $('#looks').innerHTML = `<p class="muted">${T.empty}</p>`; return; }
        $('#looks').innerHTML = items.map((it: any) => `<div class="look"><img src="${it.resultUrl ? API + it.resultUrl : ''}" alt="${it.name || ''}" /></div>`).join('');
      } catch { $('#looks').innerHTML = '<p class="muted">—</p>'; }
    }

    $('#consent').addEventListener('change', (e: any) =>
      fetch(API + '/v1/consent', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ version: CONSENT_VERSION, granted: e.target.checked }) }));
    $('#drop').addEventListener('click', () => $('#file').click());
    $('#file').addEventListener('change', async (e: any) => {
      const file = e.target.files[0]; if (!file) return;
      if (!$('#consent').checked) { alert(T.consentAlert); return; }
      $('#drop-text').textContent = T.uploading;
      const blob = await resize(file);
      const r = await fetch(API + '/v1/profile/photo', { method: 'POST', headers: { 'Content-Type': 'image/webp' }, body: blob });
      if (r.ok) { $('#drop-text').textContent = T.drop; $('#photo-status').style.display = 'block'; loadLooks(); }
      else { $('#drop-text').textContent = T.fail; }
    });
    $('#save-measures').addEventListener('click', async () => {
      await fetch(API + '/v1/profile', { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ heightCm: Number($('#height').value) || undefined, weightKg: Number($('#weight').value) || undefined }) });
      $('#save-measures').textContent = T.saved;
      setTimeout(() => ($('#save-measures').textContent = T.save), 1500);
    });
    $('#delete').addEventListener('click', async () => {
      if (!confirm(T.confirmDel)) return;
      await fetch(API + '/v1/account/delete', { method: 'POST' });
      location.reload();
    });

    loadProfile(); loadLooks();
  </script>
</Layout>
