---
import Layout from '../layouts/Layout.astro';
import '../styles/home.css';

const I = '/img/home';
const check = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.2 8.6 6.4 11.6 12.8 4.6" /></svg>';
const ring = '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9.5" /><path d="M7.8 12.3 10.7 15.1 16.4 9" /></svg>';
---

<Layout>
  <!-- ─── Hero ─── -->
  <section class="h-hero">
    <img class="h-ribbon h-ribbon-hero" src={`${I}/ribbon-right-1500.webp`} srcset={`${I}/ribbon-right-760.webp 760w, ${I}/ribbon-right-1500.webp 1500w`}
      sizes="(max-width: 760px) 100vw, 1100px" width="1500" height="374" alt="" fetchpriority="low" />
    <img class="h-ribbon h-ribbon-low" src={`${I}/ribbon-wide-1330.webp`} srcset={`${I}/ribbon-wide-700.webp 700w, ${I}/ribbon-wide-1330.webp 1330w`}
      sizes="(max-width: 760px) 90vw, 900px" width="1330" height="352" alt="" loading="lazy" />
    <div class="h-hero-in">
      <div class="h-copy">
        <p class="h-eyebrow" data-i18n="hero.eyebrow">AI VIRTUAL TRY-ON</p>
        <h1 class="h-title" data-i18n-html="hero.title">See clothes <em>on you</em>,<br />not on a model.</h1>
        <p class="h-sub" data-i18n="hero.sub">The Cabin shows you how any fashion product looks worn by you — in seconds, on any store.</p>
        <div class="h-cta">
          <a class="btn-gold" href="/profile">
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.6" /><path d="M5 20c.6-3.7 3.4-5.6 7-5.6s6.4 1.9 7 5.6" /></svg>
            <span data-i18n="hero.cta1">Create your profile</span>
          </a>
          <a class="h-btn-line" href="#action">
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9.2" /><path class="fill" d="M10.2 8.6v6.8l5.6-3.4z" /></svg>
            <span data-i18n="hero.see">See it in action</span>
          </a>
        </div>
        <ul class="h-checks">
          <li><Fragment set:html={check} /><span data-i18n="hero.k1">Realistic try-on</span></li>
          <li><Fragment set:html={check} /><span data-i18n="hero.k2">Works on any fashion site</span></li>
          <li><Fragment set:html={check} /><span data-i18n="hero.k3">Your look, your fit</span></li>
        </ul>
      </div>
      <div class="h-visual">
        <div class="h-glow" aria-hidden="true"></div>
        <img class="h-model" src={`${I}/hero-model-600.webp`} srcset={`${I}/hero-model-400.webp 400w, ${I}/hero-model-600.webp 600w`}
          sizes="(max-width: 760px) 62vw, (max-width: 1080px) 40vw, 430px" width="600" height="850"
          alt="A shopper in her own photo: cream T-shirt and jeans" fetchpriority="high" />
        <img class="h-widget" src={`${I}/hero-widget-640.webp`} srcset={`${I}/hero-widget-400.webp 400w, ${I}/hero-widget-640.webp 640w`}
          sizes="(max-width: 760px) 46vw, (max-width: 1080px) 30vw, 300px" width="640" height="684"
          alt="Her try-on of a red blazer, with a T-shirt and a black dress to choose from" decoding="async" />
      </div>
    </div>
  </section>

  <!-- ─── Three steps ─── -->
  <section class="h-sec" id="how">
    <header class="h-head">
      <h2 class="h-h2" data-i18n="steps.title">Three steps</h2>
      <p class="h-lede"><span data-i18n="steps.sub">From a photo to “I see you wearing it.”</span></p>
    </header>
    <div class="h-grid3 h-steps">
      <article class="h-card h-step">
        <div class="h-step-txt">
          <span class="h-num">1</span>
          <h3 data-i18n="s1.t">Upload your photo</h3>
          <p data-i18n="s1.d">One full-body photo. It stays yours, secured.</p>
        </div>
        <img class="h-step-img" src={`${I}/step-1.webp`} width="340" height="383" loading="lazy" decoding="async" alt="A full-body photo being uploaded" />
      </article>
      <article class="h-card h-step">
        <div class="h-step-txt">
          <span class="h-num">2</span>
          <h3 data-i18n="s2.t">“Try it on”</h3>
          <p data-i18n="s2.d">On any product, the button appears right next to “Add to cart”.</p>
        </div>
        <div class="h-step-ui" aria-hidden="true">
          <span class="h-rays"><i></i><i></i><i></i></span>
          <span class="h-try">
            <svg class="ico" viewBox="0 0 24 24"><path d="M10.2 6.4a1.9 1.9 0 1 1 2.6 1.8c-.5.2-.8.6-.8 1.1v.8" /><path d="M12 10.1 3.6 15.6c-.8.5-.4 1.6.5 1.6h15.8c.9 0 1.3-1.1.5-1.6z" /></svg>
            <span data-i18n="demo.try">Try it on</span>
          </span>
          <span class="h-cart">
            <svg class="ico" viewBox="0 0 24 24"><path d="M3.5 5h2.1l2.2 9.6c.1.5.5.8 1 .8h8.4c.5 0 .9-.3 1-.8L19.8 8H6.6" /><circle cx="9.6" cy="19" r="1.2" /><circle cx="16.6" cy="19" r="1.2" /></svg>
            <span data-i18n="demo.cart">Add to cart</span>
          </span>
        </div>
      </article>
      <article class="h-card h-step">
        <div class="h-step-txt">
          <span class="h-num">3</span>
          <h3 data-i18n="s3.t">See yourself wearing it</h3>
          <p data-i18n="s3.d">In seconds — and the look stays saved in your Cabin.</p>
        </div>
        <img class="h-step-img" src={`${I}/step-3.webp`} width="340" height="334" loading="lazy" decoding="async" alt="The try-on result, saved" />
      </article>
    </div>
  </section>

  <!-- ─── Three forms, one engine ─── -->
  <section class="h-sec" id="forms">
    <header class="h-head">
      <h2 class="h-h2" data-i18n="forms.title">Three forms, one engine</h2>
      <p class="h-lede"><span data-i18n="forms.sub">For shoppers, for stores and for independent designers.</span></p>
    </header>
    <div class="h-grid3 h-forms">
      <article class="h-card h-form">
        <img class="h-form-art h-art-ext" src={`${I}/form-ext.webp`} width="560" height="355" loading="lazy" decoding="async" alt="" />
        <div class="h-form-txt">
          <img class="h-icon" src={`${I}/icon-ext.webp`} width="54" height="48" loading="lazy" alt="" />
          <h3 data-i18n="ext.t">Browser extension</h3>
          <p data-i18n="ext.d">For shoppers — works on any fashion site, straight from the browser, with no work needed from the store.</p>
          <a class="card-link" href="#extension" data-i18n="ext.cta">Get the extension ↓</a>
        </div>
      </article>
      <article class="h-card h-form">
        <img class="h-form-art h-art-sdk" src={`${I}/form-sdk.webp`} width="560" height="479" loading="lazy" decoding="async" alt="" />
        <div class="h-form-txt">
          <img class="h-icon" src={`${I}/icon-sdk.webp`} width="53" height="48" loading="lazy" alt="" />
          <h3 data-i18n="sdk.t">SDK for stores</h3>
          <p data-i18n="sdk.d">One line of code. Loads after the page, with zero impact on speed or SEO. On every device, including iPhone.</p>
          <div class="card-links">
            <a class="card-link" href="/sdk" data-i18n="sdk.docs">Integration guide →</a>
            <a class="card-link" href="https://metaaida-shop-demo.pages.dev" target="_blank" rel="noopener" data-i18n="sdk.cta">Live example: demo store ↗</a>
          </div>
        </div>
      </article>
      <article class="h-card h-form" aria-disabled="true">
        <span class="h-soon" data-i18n="mkt.badge">Planned</span>
        <img class="h-form-art h-art-mkt" src={`${I}/form-mkt.webp`} width="600" height="417" loading="lazy" decoding="async" alt="" />
        <div class="h-form-txt">
          <img class="h-icon" src={`${I}/icon-mkt.webp`} width="53" height="48" loading="lazy" alt="" />
          <h3 data-i18n="mkt.t">Marketplace</h3>
          <p data-i18n="mkt.d">For small businesses and independent fashion designers: they list their pieces on our marketplace, where every shopper sees themselves as the model.</p>
        </div>
      </article>
    </div>
  </section>

  <!-- ─── See it in action ─── -->
  <section class="h-sec h-action-sec" id="action">
    <img class="h-ribbon h-ribbon-left" src={`${I}/ribbon-arch-520.webp`} srcset={`${I}/ribbon-arch-520.webp 520w, ${I}/ribbon-arch-1000.webp 1000w`}
      sizes="(max-width: 760px) 260px, 520px" width="1000" height="577" loading="lazy" alt="" />
    <img class="h-ribbon h-ribbon-right" src={`${I}/ribbon-arch-520.webp`} srcset={`${I}/ribbon-arch-520.webp 520w, ${I}/ribbon-arch-1000.webp 1000w`}
      sizes="(max-width: 760px) 260px, 520px" width="1000" height="577" loading="lazy" alt="" />
    <header class="h-head">
      <h2 class="h-h2" data-i18n="action.title">See it in action</h2>
      <p class="h-lede"><span data-i18n="action.sub">A few examples of The Cabin in use.</span></p>
    </header>
    <div class="h-card h-action">
      <div class="h-flow">
        <figure class="h-photo">
          <img src={`${I}/action-photo.webp`} width="182" height="460" loading="lazy" decoding="async" alt="Your photo: full body, cream T-shirt and jeans" />
          <figcaption class="h-pill" data-i18n="action.photo">Your photo</figcaption>
        </figure>
        <span class="h-op h-plus" aria-hidden="true">+</span>
        <figure class="h-garment">
          <img src={`${I}/action-garment.webp`} width="200" height="247" loading="lazy" decoding="async" alt="The product: a red blazer" />
        </figure>
        <span class="h-op h-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 5.5 15.5 12 9 18.5" /></svg></span>
        <figure class="h-result">
          <img src={`${I}/action-result.webp`} width="384" height="492" loading="lazy" decoding="async" alt="The same person wearing the red blazer" />
          <figcaption class="h-pill h-pill-gold"><span data-i18n="action.result">Virtual try-on result</span><Fragment set:html={check} /></figcaption>
        </figure>
      </div>
      <ul class="h-benefits">
        <li><Fragment set:html={ring} /><span data-i18n="action.c1">Your body, your proportions</span></li>
        <li><Fragment set:html={ring} /><span data-i18n="action.c2">Realistic fit, fabric and drape</span></li>
        <li><Fragment set:html={ring} /><span data-i18n="action.c3">Works with any product, on any store</span></li>
      </ul>
    </div>
  </section>

  <!-- ─── Get the extension ─── -->
  <section class="h-sec" id="extension">
    <div class="h-ext">
      <header class="h-ext-head">
        <h2 class="h-h2" data-i18n="dl.title">Get the extension</h2>
        <p class="h-sub2" data-i18n="dl.sub">For Chrome, Edge, Brave and other Chromium browsers, on desktop.</p>
      </header>
      <div class="h-ext-art">
        <img class="h-laptop" src={`${I}/laptop-960.webp`} srcset={`${I}/laptop-600.webp 600w, ${I}/laptop-960.webp 960w`}
          sizes="(max-width: 760px) 92vw, 540px" width="960" height="691" loading="lazy" decoding="async" alt="The Cabin on a laptop" />
        <a class="btn-gold h-dl" href="/downloads/the-cabin-extension.zip" download="the-cabin-extension.zip">
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4.5v10.2M7.6 10.6 12 15l4.4-4.4M5.5 19.5h13" /></svg>
          <span data-i18n="dl.btn">Download the extension</span>
        </a>
        <span class="h-dl-meta">v0.5.2 · ZIP · 80 KB</span>
        <p class="h-dl-note" data-i18n="dl.note">Not in the Chrome Web Store yet, so it installs by hand, in four steps.</p>
      </div>
      <div class="h-ext-steps">
        <ol class="h-ol">
          <li data-i18n-html="dl.s1">Unzip the downloaded file.</li>
          <li data-i18n-html="dl.s2">Open <code>chrome://extensions</code> (in Edge: <code class="gold">edge://extensions</code>).</li>
          <li data-i18n-html="dl.s3">Turn on <b>Developer mode</b>.</li>
          <li data-i18n-html="dl.s4">Click <b>Load unpacked</b> and choose the unzipped folder.</li>
        </ol>
        <p class="h-ext-done" data-i18n-html="dl.done">Then open any product page on <b>fashiondays.ro</b>: the gold <b>Try it on</b> button appears right under <b>Adaugă în coș</b> (Add to cart).</p>
      </div>
    </div>
  </section>

  <!-- ─── Why The Cabin ─── -->
  <section class="h-why" id="why">
    <header class="h-head">
      <h2 class="h-h2" data-i18n="why.title">Why The Cabin</h2>
      <p class="h-sub2" data-i18n="why.sub">A more personal, more confident and more effective way to shop fashion online.</p>
    </header>
    <div class="h-why-grid">
      <div class="h-why-item">
        <img src={`${I}/icon-confidence.webp`} width="41" height="40" loading="lazy" alt="" />
        <div><h3 data-i18n="w1.t">Higher confidence</h3><p data-i18n="w1.d">See the fit on you before you buy.</p></div>
      </div>
      <div class="h-why-item">
        <img src={`${I}/icon-growth.webp`} width="35" height="40" loading="lazy" alt="" />
        <div><h3 data-i18n="w2.t">Better conversion</h3><p data-i18n="w2.d">A more engaging, personal shopping experience.</p></div>
      </div>
      <div class="h-why-item">
        <img src={`${I}/icon-integration.webp`} width="35" height="40" loading="lazy" alt="" />
        <div><h3 data-i18n="w3.t">Easy integration</h3><p data-i18n="w3.d">Works on any store, with minimal effort.</p></div>
      </div>
      <div class="h-why-item">
        <img src={`${I}/icon-ecosystem.webp`} width="37" height="40" loading="lazy" alt="" />
        <div><h3 data-i18n="w4.t">A larger ecosystem</h3><p data-i18n="w4.d">Shoppers, stores and independent designers, all in one platform.</p></div>
      </div>
    </div>
  </section>
</Layout>
